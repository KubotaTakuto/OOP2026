@model List<MvcBasicSample.Models.Product>

@{
    ViewData["Title"] = "商品一覧"; //タブ用のタイトル
}

<h1>商品一覧</h1>
@*件数が0なら説明だけを表示する*@
@if (Model.Count == 0) {
    <p>商品はありません</p>
} else {
    <p>@Model.Count 件の商品があります</p>
    <ul>
        @foreach (var product in Model) {
            <li>@product.Name @product.Price 円　説明：@product.Description</li>

            @if (product.Stock == 0) {
                <sapn class=" text-danger fw-bold">売り切れ</sapn>
            } else {
                <span>在庫 @product.Stock</span>
                <p></p>
            }
        }
    </ul>
}
