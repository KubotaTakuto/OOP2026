@*このViewがProduct型を受け取る宣言*@
@* @model MvcBasicSample.Models.Product;*@
@model List<MvcBasicSample.Models.Product>

@{
    ViewData["Title"] = "商品情報";    //タブ用のタイトル
    var total = 0;
}

<h1>商品情報</h1>    @*画面内の見出し*@

<ul>@foreach (var product in Model)
    {
        <li>@product.Name @product.Price 円</li>
        total += product.Price;
    }
    <p>合計金額 @total 円</p>
</ul>
