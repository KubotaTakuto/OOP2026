@*このViewがProduct型を受け取る宣言*@
@model List<MvcBasicSample.Models.Product>

@{
    ViewData["Title"] = "商品一覧";    //タブ用のタイトル
    var total = 0;
}

<h1>商品一覧</h1>    @*画面内の見出し*@
<ul>@foreach(var product in Model){
    <li>@product.Name @product.Price 円</li>
    total += product.Price;
    }
</ul>
<p>合計金額 @total 円</p>
