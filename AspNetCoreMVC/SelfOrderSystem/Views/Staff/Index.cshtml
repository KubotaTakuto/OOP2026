@using SelfOrderSystem.Models
@model List<Order>

@{
    ViewData["Title"] = "注文受付表";
}

<link rel="stylesheet" href="~/css/staff.css" asp-append-version="true" />

<div class="order-board">

    <div class="board-header">
        <h1>注文受付表</h1>
        <span>@Model.Count 件</span>
    </div>

    <div class="order-list">

        @foreach (var order in Model) {
            var total = order.Items.Sum(i => i.UnitPrice * i.Quantity);

            <div class="order-ticket
                    @(order.Status == OrderStatus.New ? "new" :
                                   order.Status == OrderStatus.Cooking ? "cooking" :
                                   "served")">

            <div class="ticket-top">

                    <div class="table-box">
                        卓
                        <span>@order.TableNumber</span>
                    </div>

                    <div class="order-info">
                        <div class="order-no">
                            注文番号 #@order.Id
                        </div>

                        <div class="order-time">
                            @order.OrderedAtUtc
                            .ToLocalTime()
                            .ToString("HH:mm")
                        </div>
                    </div>

                    <div class="status-badge">
                        @order.Status.ToJapanese()
                    </div>

                </div>

                <div class="ticket-items">

                @foreach (var item in order.Items) {
                        <div class="item-row">
                            <span>@item.Product?.Name</span>
                            <strong>@item.Quantity 個</strong>
                        </div>
                    }

                </div>

                <div class="ticket-footer">

                    <div class="ticket-total">
                        ¥@total.ToString("N0")
                    </div>

                    @if (order.Status != OrderStatus.Served) {
                        <form asp-controller="Staff"
                              asp-action="Advance"
                              method="post">

                            <input type="hidden"
                                   name="id"
                                   value="@order.Id" />

                            <button type="submit"
                                    class="ticket-button">

                                @order.Status.NextActionLabel()

                            </button>

                        </form>
                    } else {
                        <div class="done-text">
                            提供完了
                        </div>
                    }

                </div>
            </div>
        }

    </div>
</div>