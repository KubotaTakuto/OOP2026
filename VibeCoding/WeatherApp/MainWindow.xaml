<Window x:Class="AIWeather.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI天気予報"
        Height="600"
        Width="800">

    <Grid>
        <StackPanel VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <ComboBox x:Name="CityComboBox"
          Width="200"
          Margin="0,0,0,10"
          SelectionChanged="CityComboBox_SelectionChanged">

                <ComboBoxItem Content="東京" IsSelected="True"/>
                <ComboBoxItem Content="大阪"/>
                <ComboBoxItem Content="名古屋"/>
                <ComboBoxItem Content="福岡"/>
                <ComboBoxItem Content="札幌"/>

            </ComboBox>

            <TextBlock Text="🌤 AI Weather"
           FontSize="26"
           FontWeight="Bold"
           Foreground="White"
           HorizontalAlignment="Center"/>

            <TextBlock Text="東京の天気"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

            <TextBlock x:Name="TemperatureText"
                   FontSize="48"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"/>

            <TextBlock x:Name="WeatherText"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="White"
                   HorizontalAlignment="Center"/>

            <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Center">

                <TextBlock x:Name="HumidityText"
                       Margin="10"
                       FontSize="16"
                       Foreground="White"/>

                <TextBlock x:Name="WindText"
                       Margin="10"
                       FontSize="16"
                       Foreground="White"/>

            </StackPanel>

            <TextBlock Text="7日間予報"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,20,0,10"/>

            <ListBox x:Name="ForecastList"
                       Height="180"
                       Background="Transparent"
                       BorderThickness="0"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       ScrollViewer.VerticalScrollBarVisibility="Disabled">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.Resources>

                    <Style TargetType="ListBoxItem">
                        <Setter Property="Width" Value="90"/>
                        <Setter Property="Height" Value="120"/>
                        <Setter Property="Margin" Value="5"/>
                        <Setter Property="HorizontalContentAlignment"
                Value="Center"/>
                    </Style>

                </ListBox.Resources>
            </ListBox>
        </StackPanel>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0"
                         EndPoint="0,1">
                <GradientStop Color="#4FC3F7"
                      Offset="0"/>
                <GradientStop Color="#81D4FA"
                      Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
    </Grid>

</Window>